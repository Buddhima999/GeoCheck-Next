# Copy this file to .env before using Docker Compose.
# Replace this placeholder with a unique, long secret before starting the app.
GEOCHECK_API_KEY=replace-with-a-long-random-secret

# Optional map tiles. Public OSM tiles receive viewport requests; use synthetic data unless an approved provider is configured.
VITE_MAP_TILE_URL=

# Customer-to-DP distance rule. Default is a local Haversine calculation.
# Set to google_routes to use Google Maps driving-route distance instead.
DISTANCE_METHOD=straight_line
CUSTOMER_DP_LIMIT_M=500
DP_PORT_CAPACITY=8

# Optional: configure a backend-only key after enabling the needed APIs and billing.
# Never use this key in frontend variables or commit a real key.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_GEOCODING_ENABLED=false
GOOGLE_MAPS_MAX_REQUESTS_PER_RUN=1000
GOOGLE_MAPS_TIMEOUT_SECONDS=8
GOOGLE_ADDRESS_MATCH_TOLERANCE_M=500
