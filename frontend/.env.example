# Public HTTPS URL of the deployed FastAPI service. Leave blank for local Vite proxy.
VITE_API_BASE_URL=

# Optional Google Maps JavaScript key for road/satellite map styles.
# This key is delivered to browsers; restrict it in Google Cloud by HTTP referrer
# and enable only the Maps JavaScript API. Do not use a server-side secret here.
# Copy this file to .env.local and add your restricted key. Without it, maps use OSM.
VITE_GOOGLE_MAPS_API_KEY=your_restricted_google_maps_browser_key

# Optional custom map tile provider used by the OpenStreetMap fallback.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
