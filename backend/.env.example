# Copy to .env and configure your own values.
# Never commit real credentials, API keys or customer data.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=geocheck_next
API_CORS_ORIGINS=http://localhost:5173

# Required for CSV upload and validation-run status endpoints.
# Use a long, unique random secret; do not use this example value in production.
GEOCHECK_API_KEY=replace-with-a-long-random-secret

# Upload/worker limits. The API and worker must share the same persistent directory.
UPLOAD_DIR=var/uploads
MAX_UPLOAD_BYTES=536870912
MAX_CSV_ROWS=1000000
WORKER_POLL_SECONDS=2
WORKER_STALE_AFTER_SECONDS=900
WORKER_BATCH_SIZE=1000

WORKER_MAX_ATTEMPTS=2
REFERENCE_DATA_DIR=reference-data
