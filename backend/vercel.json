{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "includeFiles": "reference-data/**"
    }
  },
  "daemons": {
    "geocheck-worker": {
      "root": "./",
      "entrypoint": "Dockerfile",
      "command": ["python", "-m", "app.worker"],
      "instances": {
        "sin1": 1
      }
    }
  }
}
